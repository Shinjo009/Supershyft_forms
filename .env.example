# Copy to .env in the project root, then restart the dev server (npm run dev).

VITE_BACKEND_BASE_URL=https://api.supershyft.com

# Engagement code used for onboard. No hardcoded fallback — this value is required.
VITE_ENGAGEMENT_CODE=

# Razorpay Payment Link — opened after Confirm. Restart the dev server after changing this.
VITE_RAZORPAY_PAYMENT_LINK_URL=
