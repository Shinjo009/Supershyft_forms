# Copy to .env in the project root, then restart the dev server (npm run dev).

VITE_BACKEND_BASE_URL=https://api.supershyft.com

# Celebal engagement codes only (by gender). Do NOT set VITE_ENGAGEMENT_CODE or
# VITE_CBTW_ENGAGEMENT_CODE — those route to the old CBTW engagement (CBMU0626).
VITE_CELEBAL_ENGAGEMENT_CODE_MALE=CBJP0626
VITE_CELEBAL_ENGAGEMENT_CODE_FEMALE=CBJF0626
