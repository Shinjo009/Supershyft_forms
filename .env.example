# Copy to .env in the project root, then restart the dev server (npm run dev).

VITE_BACKEND_BASE_URL=https://api.supershyft.com

# Celebal engagement codes only (by gender). Do NOT set VITE_ENGAGEMENT_CODE or
# VITE_CBTW_ENGAGEMENT_CODE — those route to the old CBTW engagement (CBMU0626).
VITE_CELEBAL_ENGAGEMENT_CODE_MALE=DDMH0526
VITE_CELEBAL_ENGAGEMENT_CODE_FEMALE=DDFH0526

# Razorpay Payment Link — opened when the user taps "Proceed to Payment"
VITE_RAZORPAY_PAYMENT_LINK_URL=https://rzp.io/rzp/Xml9FK3

# In Razorpay dashboard → Payment Link → Callback URL, set your form URL, e.g.:
#   Local:  http://localhost:5173/
#   Prod:   https://your-domain.com/
# After payment, Razorpay redirects back with ?razorpay_payment_link_status=paid|failed|cancelled

# Dev only — skip Razorpay and complete booking immediately (Booking Confirmed)
# VITE_SKIP_RAZORPAY=true

# Dev only — skip Razorpay and show Payment Failed page
# VITE_PAYMENT_TEST_FAIL=true
